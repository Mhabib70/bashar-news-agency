# ── توسعه محلی (پیش‌فرض) — فایل SQLite ──
DATABASE_URL=file:./db/custom.db

# ── استقرار ابری رایگان (Turso) ──
# اگر این دو مقدار تنظیم شوند، اپ به‌جای فایل محلی از دیتابیس ابری استفاده می‌کند
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=your-token

# ── کلید امضای نشست (الزامی برای استقرار دائمی) ──
# کوکی نشست با HMAC-SHA256 امضا می‌شود. اگر این مقدار تنظیم نشود،
# یک کلید تصادفی موقت ساخته می‌شود و با هر ری‌استارت سرور همهٔ نشست‌ها باطل می‌شوند.
# برای ساخت کلید: openssl rand -hex 32
SESSION_SECRET=

# ── شمارهٔ محافظت‌شدهٔ ادمین کل سامانه ──
# فقط سمت سرور خوانده می‌شود (در باندل کلاینت لو نمی‌رود).
# اگر تنظیم نشود، مقدار پیش‌فرض تاریخی استفاده می‌شود.
# SUPER_ADMIN_PHONE=09300500977

# ── ربات ایتا (اختیاری) ──
# BASHAR_EITAA_TOKEN=your-bot-token
# BASHAR_EITAA_CHANNEL=@your-channel
