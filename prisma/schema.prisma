generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// نقش‌ها: reporter (خبرنگار) | district_manager (مدیر حوزه) | specialist (کارشناس) | admin (ادمین کل)
model User {
  id              String    @id @default(cuid())
  username        String    @unique
  fullName        String
  role            String    @default("reporter")
  status          String    @default("active") // active | pending | rejected
  district        String    @default("") // b1..b6, s1..s6
  base            String    @default("")
  phone           String    @default("")
  age             String    @default("")
  education       String    @default("")
  points          Int       @default(0)
  forumPoints     Int       @default(0) // امتیاز تالار گفتگو — پاداش پیام/تاپیک/واکنش‌گیری
  canSendEitaa    Boolean   @default(false) // مجوز ارسال خبر به کانال ایتا (فقط با اجازهٔ ادمین کل)
  pinHash         String    @default("") // رمز دوم اختیاری (۴ تا ۶ رقم) — اگر تنظیم شود ورود دومرحله‌ای می‌شود
  levelKey        String    @default("rookie") // rookie | follower | active | pro | expert
  currentStreak   Int       @default(0)
  bestStreak      Int       @default(0)
  lastActivityAt  DateTime?
  lastDemotionAt  DateTime?
  rejectReason    String    @default("")
  avatar          String    @default("") // عکس پروفایل (data URL بعد از تغییر اندازه در سمت کلاینت)
  lastSeenAt      DateTime  @default(now()) // آخرین حضور در اپ — برای نقطه آنلاین تالار
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  news            NewsItem[]
  badges          UserBadge[]
  pointsLogs      PointsLog[]
  drafts          Draft[]
  notifSetting    NotifSetting?
  participations  ChallengeParticipation[]
  notifications   Notification[]
}

// اخبار با چرخه بررسی سه‌مرحله‌ای: district → specialist → admin
model NewsItem {
  id           Int       @id @default(autoincrement())
  code         String    @default("") // کد پیگیری مثل N-1042
  reporterId   String
  reporter     User      @relation(fields: [reporterId], references: [id])
  district     String    @default("")
  category     String    @default("none")
  title        String
  content      String    @default("")
  mediaType    String    @default("none") // none | photo | video
  status       String    @default("pending") // pending | approved | rejected
  reviewStage  String    @default("district") // district | specialist | admin | "" (پایان)
  rejectReason String    @default("")
  rejectNote   String    @default("")
  reviewedBy   String    @default("")
  reviewedAt   DateTime?
  challengeId  Int?
  mediaUrl     String @default("") // آدرس فایل رسانه آپلودشده
  durationMin  Int    @default(0) // زمان صرف‌شده برای تهیه خبر (دقیقه)
  preparedAt   DateTime? // تاریخ و ساعت تهیه خبر (انتخاب خبرنگار)
  views        Int    @default(0) // بازدید خبر در اپ
  eitaaReactions Int  @default(0) // واکنش‌های ثبت‌شده از کانال ایتا (ورود دستی ادمین)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events NewsEvent[]
}

// ردپای کامل چرخه بررسی — پیش‌نمایش آنلاین مراحل برای خبرنگار و مدیران
model NewsEvent {
  id        Int      @id @default(autoincrement())
  newsId    Int
  news      NewsItem @relation(fields: [newsId], references: [id], onDelete: Cascade)
  stage     String   @default("") // "" (ارسال/بازارسال) | district | specialist | admin
  action    String   // submitted | advanced | final_approved | rejected | resubmitted
  actorId   String   @default("")
  actorName String   @default("")
  actorRole String   @default("")
  note      String   @default("") // دلیل رد یا یادداشت
  createdAt DateTime @default(now())

  @@index([newsId, createdAt])
}

model Challenge {
  id          Int       @id @default(autoincrement())
  code        String    @default("")
  title       String
  description String    @default("")
  deadlineAt  DateTime
  endAt       DateTime
  reward      String    @default("")
  status      String    @default("active") // active | finished
  createdBy   String    @default("")
  deadlineNotified Boolean @default(false) // یادآور مهلت یک‌بار ارسال شد
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
  participations ChallengeParticipation[]
}

model ChallengeParticipation {
  id          Int       @id @default(autoincrement())
  challengeId Int
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  count       Int       @default(0)
  joinedAt    DateTime  @default(now())

  @@unique([challengeId, userId])
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  badgeKey  String // first_news | prolific | quality | streak7 | professional | champion
  awardedAt DateTime @default(now())

  @@unique([userId, badgeKey])
}

model PointsLog {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String   @default("")
  ref       String   @default("")
  createdAt DateTime @default(now())
}

model Draft {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  category    String    @default("none")
  title       String    @default("")
  content     String    @default("")
  mediaType   String    @default("none") // none | photo | video
  mediaUrl    String    @default("")
  durationMin Int       @default(0)
  preparedAt  DateTime?
  savedAt     DateTime  @default(now())
}

model NotifSetting {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id])
  approvals Boolean  @default(true)
  challenges Boolean @default(true)
  broadcast Boolean  @default(true)
  rejections Boolean @default(true)
  quietStart String  @default("22:00")
  quietEnd   String  @default("08:00")
  updatedAt DateTime @updatedAt
}

// اعلان‌های درون‌برنامه‌ای — معادل پیام‌های ربات با احترام به تنظیمات و ساعت سکوت
model Notification {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  kind        String // approved | rejected | badge | broadcast | challenge | challenge_reminder | rank | review | user_status | demotion
  title       String
  body        String    @default("")
  ref         String    @default("")
  deliveredAt DateTime  @default(now()) // با ساعت سکوت به پایان سکوت موکول می‌شود
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, deliveredAt])
}

// حوزه‌ها و پایگاه‌های سازمان — قابل ویرایش توسط ادمین کل و مدیر حوزه (جدول تک‌ردیفی)
model OrgUnits {
  id        Int      @id @default(1)
  json      String // [{key,label,bases[]}]
  updatedAt DateTime @updatedAt
}

// بخش آموزش (آکادمی) — محتوای آموزشی (متن/فایل/ویدئو) با دسته، سطح، مدت و بازدید
model Training {
  id         Int      @id @default(autoincrement())
  title      String
  body       String   @default("")
  kind       String   @default("text") // text | file | video
  fileUrl    String   @default("")
  category   String   @default("writing") // writing | photo | reporting | media | tech
  level      String   @default("beginner") // beginner | intermediate | advanced
  minutes    Int      @default(5) // زمان مطالعه (دقیقه)
  views      Int      @default(0)
  authorId   String   @default("")
  authorName String   @default("")
  createdAt  DateTime @default(now())

  progress TrainingProgress[]

  @@index([createdAt])
  @@index([category])
}

// پیشرفت آموزشی هر کاربر — «خوانده شد»
model TrainingProgress {
  id          Int      @id @default(autoincrement())
  trainingId  Int
  training    Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  userId      String
  completedAt DateTime @default(now())

  @@unique([trainingId, userId])
  @@index([userId])
}

// تالار گفتگو — تاپیک‌ها و پیام‌ها (کلاس تصویری، هم‌فکری و...)
model ForumTopic {
  id          Int      @id @default(autoincrement())
  title       String
  type        String   @default("class") // class (کلاس تصویری) | brainstorm (هم‌فکری) | announce (اطلاع‌رسانی) | challenge (چالش)
  pinned      Boolean  @default(false)
  createdBy   String
  creatorName String   @default("")
  createdAt   DateTime @default(now())
  messages    ForumMessage[]
  polls       ForumPoll[]
}

model ForumMessage {
  id         Int        @id @default(autoincrement())
  topicId    Int
  topic      ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId     String
  authorName String     @default("")
  authorRole String     @default("")
  body       String
  fileUrl    String     @default("")
  replyToId  Int?
  replyTo    ForumMessage?  @relation("ReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    ForumMessage[] @relation("ReplyTo")
  reactions  ForumReaction[]
  createdAt  DateTime   @default(now())

  @@index([topicId, createdAt])
}

// واکنش سریع به پیام — هر کاربر هر ایموجی فقط یک‌بار (toggle)
model ForumReaction {
  id        Int          @id @default(autoincrement())
  messageId Int
  message   ForumMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String // 😍 | 👍 | 🔥 | 💡
  createdAt DateTime     @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// نظرسنجی داخل تاپیک — گزینه‌ها Json (آرایه رشته) و رأی‌ها Json (نقشه userId → شماره گزینه)
model ForumPoll {
  id        Int        @id @default(autoincrement())
  topicId   Int
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  question  String
  options   Json
  votes     Json // نقشه userId → شماره گزینه (در create همیشه {} می‌گذاریم)
  createdBy String
  createdAt DateTime   @default(now())

  @@index([topicId])
}

// سوال هفته ادمین — پرچم بالای تالار؛ با یک تاپیک گفتگو گره می‌خورد
model ForumWeeklyQuestion {
  id        Int    @id @default(autoincrement())
  question  String
  topicId   Int    // تاپیک گفتگویی که برای این سوال ساخته می‌شود
  createdBy String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
